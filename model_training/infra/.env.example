# model_training/infra/.env.example — copy to model_training/infra/.env.
# Values here are for the bundled store (profile local-s3). For an existing S3, set
# S3_ENDPOINT to its URL, or set S3_ENDPOINT= (empty) for AWS, the region, the
# credentials, and S3_PRESIGNED_ENDPOINT to the same URL, then start without
# --profile local-s3.
MLFLOW_PORT=5000
LAKEFS_PORT=8000
S3_PORT=8333
S3_ENDPOINT=http://seaweedfs:8333
S3_PRESIGNED_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=seaweedadmin
S3_SECRET_ACCESS_KEY=seaweedadmin-secret
LAKEFS_ACCESS_KEY_ID=AKIAIOSFOLKFSSAMPLES
LAKEFS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
