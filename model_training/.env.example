# ==================================================
# MODEL TRAINING / MLFLOW
# ==================================================
# Copy this file to model_training/.env and adjust values for the training host.

# MLflow tracking URI used by training and model registration.
# Prefer an absolute SQLite URI when training/deployment are started from different folders,
# for example: sqlite:////home/user/mlops/model_training/mlflow.db
TRACKING_URI=sqlite:///mlflow.db

# Training experiment and champion selection.
EXPERIMENT_NAME=anomaly-detection
CHAMPION_METRIC=validation_accuracy

# Model registration settings used by mlflow_registry.py.
MODEL_NAME=champion_model
MODEL_ALIAS=champion
ARTIFACT_PATH=model

# Optional S3-compatible MLflow artifact endpoint (for example MinIO).
MLFLOW_S3_ENDPOINT_URL=

# Training/registration logging.
LOG_LEVEL=INFO
