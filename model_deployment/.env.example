# ==================================================
# DEPLOYMENT MODEL SOURCE
# ==================================================
# Copy this file to model_deployment/.env and adjust values for the deployment host.
#
# LOCAL_MODEL_PATH takes precedence over MLflow. When it is set, the deployment
# workflow does not require TRACKING_URI, MODEL_NAME, MODEL_ALIAS, or MODEL_VERSION.
LOCAL_MODEL_PATH=
LOCAL_MODEL_NAME=                         # Optional local deployment name; defaults to file stem
LOCAL_MODEL_FORMAT=auto                   # auto | keras | onnx | joblib | pickle | pytorch | tflite | xgboost

# ==================================================
# MLFLOW REGISTERED-MODEL SOURCE
# Used only when LOCAL_MODEL_PATH is empty
# ==================================================
TRACKING_URI=sqlite:////absolute/path/to/model_training/mlflow.db
MODEL_NAME=champion_model
MODEL_ALIAS=champion
MODEL_VERSION=                             # Optional explicit registered-model version
MLFLOW_S3_ENDPOINT_URL=                    # Optional S3-compatible artifact endpoint

# ==================================================
# COMMON DEPLOYMENT SETTINGS
# ==================================================
DEPLOYMENT_BACKEND=aws_sagemaker           # aws_sagemaker | kubernetes | docker_compose
LOG_LEVEL=INFO
DEPLOYMENT_READINESS_TIMEOUT_SECONDS=900
DEPLOYMENT_POLL_INTERVAL_SECONDS=10
PROMETHEUS_DISCOVERY_TIMEOUT_SECONDS=120
PROMETHEUS_DISCOVERY_POLL_INTERVAL_SECONDS=5

# ==================================================
# AWS SAGEMAKER BACKEND
# ==================================================
AWS_ACCESS_KEY_ID=                         # Keep real values only in model_deployment/.env
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=eu-central-1
AWS_DOCKER_REGISTRY=<aws-account-id>.dkr.ecr.eu-central-1.amazonaws.com/mlops-blueprint
AWS_DOCKER_PLATFORM=linux/amd64
SAGEMAKER_ROLE_ARN=<sagemaker-execution-role-arn>
SAGEMAKER_INSTANCE_TYPE=ml.m5.xlarge
SAGEMAKER_INSTANCE_COUNT=1
SAGEMAKER_VARIANT_NAME=AllTraffic
SAGEMAKER_LATENCY_THRESHOLD_US=1000000
SAGEMAKER_ALARM_PERIOD=60
SAGEMAKER_EVALUATION_PERIODS=3

# ==================================================
# KUBERNETES / KSERVE BACKEND
# ==================================================
KUBE_CONTEXT=<kube-context>
KUBE_NAMESPACE=mlops
KUBE_DEPLOYMENT_NAME=champion-model
KUBE_DOCKER_REGISTRY=<registry-host>/<repository-prefix>
KUBE_DOCKER_PLATFORM=
KUBE_IMAGE_PULL_SECRET=
KUBE_KSERVE_DEPLOYMENT_MODE=Standard       # Standard | Knative
KUBE_IMAGE_PULL_POLICY=IfNotPresent
KUBE_CPU_REQUEST=250m
KUBE_MEM_REQUEST=512Mi
KUBE_CPU_LIMIT=1
KUBE_MEM_LIMIT=1Gi
KUBE_MIN_REPLICAS=1
KUBE_MAX_REPLICAS=1
KUBE_SCRAPE_INTERVAL=15s
KUBE_PROMETHEUS_RELEASE_LABEL=prometheus
KUBE_PROMETHEUS_URL=
KUBE_NODE_SELECTOR_JSON={}
KUBE_EXTRA_RESOURCE_LIMITS_JSON={}
KUBE_RUNTIME_CLASS=

# ==================================================
# DOCKER COMPOSE BACKEND
# ==================================================
COMPOSE_PROJECT_NAME=
COMPOSE_DOCKER_PLATFORM=
COMPOSE_MODEL_PORT=8000
COMPOSE_ENABLE_PROMETHEUS=true
COMPOSE_PROMETHEUS_PORT=9090
COMPOSE_ENABLE_GRAFANA=true
COMPOSE_GRAFANA_PORT=3000
COMPOSE_EXTERNAL_PROMETHEUS_URL=

# ==================================================
# OPTIONAL TEST OVERRIDES
# ==================================================
# IMAGE_PATH can point to an inference image outside model_training/data.
IMAGE_PATH=
KSERVE_ENDPOINT_URL=http://127.0.0.1:18000/predict
KSERVE_BASE_URL=http://127.0.0.1:18000
TEST_PROMETHEUS_URL=http://127.0.0.1:19090
TEST_GRAFANA_URL=http://127.0.0.1:13000
TEST_EXTERNAL_PROMETHEUS_URL=
TEST_EXTERNAL_GRAFANA_URL=
GRAFANA_USER=admin
GRAFANA_PASSWORD=
