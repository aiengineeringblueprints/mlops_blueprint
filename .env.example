# ==================================================
# MLFLOW / MODEL REGISTRY
# Shared by training, registration, and deployment
# ==================================================
TRACKING_URI=sqlite:///mlflow.db           # MLflow tracking and registry URI
MODEL_NAME=champion_model                  # Registered model name
MODEL_ALIAS=champion                       # Registry alias used for deployment
MODEL_VERSION=                             # Optional explicit version override
MLFLOW_S3_ENDPOINT_URL=                    # Optional S3-compatible artifact endpoint


# ==================================================
# TRAINING / MODEL REGISTRATION
# Not required when only deploying an existing model
# ==================================================
EXPERIMENT_NAME=anomaly-detection          # MLflow experiment used during training
ARTIFACT_PATH=model                        # Artifact name used when logging the model
CHAMPION_METRIC=validation_accuracy        # Metric used to select/tag the champion


# ==================================================
# COMMON DEPLOYMENT SETTINGS
# Used by all deployment backends
# ==================================================
DEPLOYMENT_BACKEND=aws_sagemaker           # aws_sagemaker | kubernetes | docker_compose
LOG_LEVEL=INFO
DEPLOYMENT_READINESS_TIMEOUT_SECONDS=900
DEPLOYMENT_POLL_INTERVAL_SECONDS=10
PROMETHEUS_DISCOVERY_TIMEOUT_SECONDS=120  # Maximum wait for Prometheus target discovery
PROMETHEUS_DISCOVERY_POLL_INTERVAL_SECONDS=5  # Prometheus discovery polling interval

# ==================================================
# AWS SAGEMAKER BACKEND
# ==================================================
AWS_ACCESS_KEY_ID=                        # Local AWS access key; keep real value only in .env
AWS_SECRET_ACCESS_KEY=                    # Local AWS secret key; never commit it
AWS_SESSION_TOKEN=                        # Optional token for temporary AWS credentials
AWS_REGION=eu-central-1                   # Region for ECR, SageMaker, and CloudWatch
AWS_DOCKER_REGISTRY=<aws-account-id>.dkr.ecr.eu-central-1.amazonaws.com/mlops-blueprint  # ECR repository URI
AWS_DOCKER_PLATFORM=linux/amd64           # Must match the SageMaker instance architecture
SAGEMAKER_ROLE_ARN=<sagemaker-execution-role-arn>  # SageMaker execution role
SAGEMAKER_INSTANCE_TYPE=ml.m5.xlarge      # SageMaker inference instance type
SAGEMAKER_INSTANCE_COUNT=1                # Initial endpoint instance count
SAGEMAKER_VARIANT_NAME=AllTraffic         # SageMaker production variant name
SAGEMAKER_LATENCY_THRESHOLD_US=1000000    # CloudWatch ModelLatency alarm threshold
SAGEMAKER_ALARM_PERIOD=60                 # CloudWatch alarm period in seconds
SAGEMAKER_EVALUATION_PERIODS=3            # Number of CloudWatch evaluation periods

# ==================================================
# KUBERNETES / KSERVE BACKEND
# ==================================================
KUBE_CONTEXT=<kube-context>               # kubeconfig context selecting the target cluster
KUBE_NAMESPACE=mlops                      # Existing namespace used for deployment
KUBE_DEPLOYMENT_NAME=champion-model       # DNS-safe Kubernetes/KServe resource base name
KUBE_DOCKER_REGISTRY=<registry-host>/<repository-prefix>  # Registry reachable by cluster nodes
KUBE_DOCKER_PLATFORM=                     # Optional platform, e.g. linux/amd64 or linux/arm64
KUBE_IMAGE_PULL_SECRET=                   # Optional pre-provisioned private-registry Secret
KUBE_KSERVE_DEPLOYMENT_MODE=Standard      # KServe mode: Standard | Knative | ModelMesh
KUBE_IMAGE_PULL_POLICY=IfNotPresent       # Kubernetes image pull policy
KUBE_CPU_REQUEST=250m                     # Predictor CPU request
KUBE_MEM_REQUEST=512Mi                    # Predictor memory request
KUBE_CPU_LIMIT=1                          # Predictor CPU limit
KUBE_MEM_LIMIT=1Gi                        # Predictor memory limit
KUBE_MIN_REPLICAS=1                       # Minimum predictor replicas
KUBE_MAX_REPLICAS=1                       # Maximum predictor replicas
KUBE_SCRAPE_INTERVAL=15s                  # PodMonitor scrape interval
KUBE_PROMETHEUS_RELEASE_LABEL=prometheus  # Prometheus Operator release label
KUBE_PROMETHEUS_URL=                      # Optional URL for external target verification
KUBE_NODE_SELECTOR_JSON={}                # Optional node selector JSON object
KUBE_EXTRA_RESOURCE_LIMITS_JSON={}        # Optional extra resource limits, e.g. GPU resource
KUBE_RUNTIME_CLASS=                       # Optional Kubernetes RuntimeClass

# ==================================================
# DOCKER COMPOSE BACKEND
# ==================================================
COMPOSE_PROJECT_NAME=                     # Optional project name; defaults to mlops-<model-name>
COMPOSE_DOCKER_PLATFORM=                  # Optional Docker platform for the model image
COMPOSE_MODEL_PORT=8000                   # Host port for the model API and /metrics endpoint
COMPOSE_ENABLE_PROMETHEUS=true            # Start the bundled Prometheus container
COMPOSE_PROMETHEUS_PORT=9090              # Host port used only when bundled Prometheus is enabled
COMPOSE_ENABLE_GRAFANA=true               # Start the bundled Grafana container
COMPOSE_GRAFANA_PORT=3000                 # Host port used only when bundled Grafana is enabled
COMPOSE_EXTERNAL_PROMETHEUS_URL=          # Required only for bundled Grafana + external Prometheus
