# ==================================================
# MODEL TRAINING / MLFLOW
# ==================================================
# Copy this file to model_training/.env and adjust values for the training host.

# MLflow tracking URI. The infra stack (infra/docker-compose.yml) serves MLflow on port 5000.
# A file-based fallback without the stack: sqlite:///mlflow.db
TRACKING_URI=http://127.0.0.1:5000

# Training experiment, champion selection and registry names.
EXPERIMENT_NAME=screw-classifier
CHAMPION_METRIC=validation_accuracy
MODEL_NAME=screw_classifier
MODEL_ALIAS=champion
ARTIFACT_PATH=model

# Client configuration for the LakeFS helper scripts (setup_lakefs.py, prepare_lakefs_branch.py,
# commit_lakefs.py). lakectl reads these environment variables; no config file is needed.
LAKECTL_SERVER_ENDPOINT_URL=http://127.0.0.1:8000
LAKECTL_CREDENTIALS_ACCESS_KEY_ID=AKIAIOSFOLKFSSAMPLES
LAKECTL_CREDENTIALS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# S3 as seen from this host (boto3 in setup_lakefs.py). Bundled store: http://127.0.0.1:8333.
# Existing S3: its URL, or empty for AWS. Credentials as in infra/.env.
S3_HOST_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=seaweedadmin
S3_SECRET_ACCESS_KEY=seaweedadmin-secret
S3_BUCKET=anomaly-detection
LAKEFS_REPO=anomaly-detection-data

# Optional S3-compatible MLflow artifact endpoint (for example SeaweedFS).
MLFLOW_S3_ENDPOINT_URL=

# Training/registration logging.
LOG_LEVEL=INFO
