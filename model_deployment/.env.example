# ==================================================
# DEPLOYMENT MODEL SOURCE
# ==================================================

# Copy this file to model_deployment/.env and adjust values for the deployment host.

# Optional local model file path. When set, local-model deployment is used instead of MLflow.
LOCAL_MODEL_PATH=

# Optional local-model name. Defaults to the local file name without its extension.
LOCAL_MODEL_NAME=

# Local model format. "auto" detects the format from the file extension.
LOCAL_MODEL_FORMAT=auto                   # auto | keras | onnx | joblib | pickle | pytorch | tflite | xgboost


# ==================================================
# MLFLOW REGISTERED-MODEL SOURCE
# Used only when LOCAL_MODEL_PATH is empty
# ==================================================

# MLflow tracking/registry URI used to resolve the registered model.
TRACKING_URI=sqlite:////absolute/path/to/model_training/mlflow.db

# Registered model name in MLflow Model Registry.
MODEL_NAME=champion_model

# MLflow alias used when MODEL_VERSION is not explicitly provided.
MODEL_ALIAS=champion

# Optional exact registered-model version; overrides alias-based resolution.
MODEL_VERSION=

# Optional S3-compatible MLflow artifact endpoint such as MinIO.
MLFLOW_S3_ENDPOINT_URL=


# ==================================================
# COMMON DEPLOYMENT SETTINGS
# ==================================================

# Select exactly one deployment backend.
DEPLOYMENT_BACKEND=aws_sagemaker           # aws_sagemaker | kubernetes | docker_compose

# Application logging level.
LOG_LEVEL=INFO

# Maximum time to wait for a deployment to become ready.
DEPLOYMENT_READINESS_TIMEOUT_SECONDS=900

# Interval between deployment-readiness checks.
DEPLOYMENT_POLL_INTERVAL_SECONDS=10

# Maximum time to wait for Prometheus target discovery.
PROMETHEUS_DISCOVERY_TIMEOUT_SECONDS=120

# Interval between Prometheus target-discovery checks.
PROMETHEUS_DISCOVERY_POLL_INTERVAL_SECONDS=5


# ==================================================
# AWS SAGEMAKER BACKEND
# ==================================================

# AWS access key. Keep real credentials only in model_deployment/.env or the host environment.
AWS_ACCESS_KEY_ID=

# AWS secret access key corresponding to AWS_ACCESS_KEY_ID.
AWS_SECRET_ACCESS_KEY=

# Optional temporary AWS session token.
AWS_SESSION_TOKEN=

# AWS region used for ECR, SageMaker, and CloudWatch resources.
AWS_REGION=eu-central-1

# ECR repository used to store the deployment image.
AWS_DOCKER_REGISTRY=<aws-account-id>.dkr.ecr.eu-central-1.amazonaws.com/mlops-blueprint

# REQUIRED:  Must match the target compute architecture.
# Common Docker platform examples: linux/amd64 | linux/arm64 | linux/arm/v7 | linux/arm/v6 | linux/386
AWS_DOCKER_PLATFORM=linux/amd64

# IAM execution role used by SageMaker.
SAGEMAKER_ROLE_ARN=<sagemaker-execution-role-arn>

# SageMaker instance type used for inference.
SAGEMAKER_INSTANCE_TYPE=ml.m5.xlarge

# Number of SageMaker inference instances.
SAGEMAKER_INSTANCE_COUNT=1

# Name of the SageMaker production variant.
SAGEMAKER_VARIANT_NAME=AllTraffic

# CloudWatch ModelLatency alarm threshold in microseconds.
SAGEMAKER_LATENCY_THRESHOLD_US=1000000

# CloudWatch alarm evaluation period in seconds.
SAGEMAKER_ALARM_PERIOD=60

# Number of CloudWatch alarm evaluation periods.
SAGEMAKER_EVALUATION_PERIODS=3


# ==================================================
# KUBERNETES / KSERVE BACKEND
# ==================================================

# kubectl context identifying the target Kubernetes cluster.
KUBE_CONTEXT=<kube-context>

# Kubernetes namespace used for deployment resources.
KUBE_NAMESPACE=mlops

# Kubernetes/KServe deployment name. Use lowercase letters, numbers, and hyphens only.
KUBE_DEPLOYMENT_NAME=champion-model

# Registry/repository prefix used to push the Kubernetes image.
KUBE_DOCKER_REGISTRY=<registry-host>/<repository-prefix>

# REQUIRED: Must match the target node architecture.
# Common Docker platform examples: linux/amd64 | linux/arm64 | linux/arm/v7 | linux/arm/v6 | linux/386
KUBE_DOCKER_PLATFORM=linux/amd64

# Optional Kubernetes imagePullSecret for private registry access.
KUBE_IMAGE_PULL_SECRET=

# KServe deployment mode used by the target cluster.
KUBE_KSERVE_DEPLOYMENT_MODE=Standard       # Standard | Knative | ModelMesh

# Kubernetes image pull policy.
KUBE_IMAGE_PULL_POLICY=IfNotPresent

# Requested CPU resource for the inference workload.
KUBE_CPU_REQUEST=250m

# Requested memory resource for the inference workload.
KUBE_MEM_REQUEST=512Mi

# Maximum CPU resource allowed for the inference workload.
KUBE_CPU_LIMIT=1

# Maximum memory resource allowed for the inference workload.
KUBE_MEM_LIMIT=1Gi

# Minimum number of serving replicas.
KUBE_MIN_REPLICAS=1

# Maximum number of serving replicas.
KUBE_MAX_REPLICAS=1

# Prometheus metric-scraping interval.
KUBE_SCRAPE_INTERVAL=15s

# Prometheus Operator release label used by the PodMonitor.
KUBE_PROMETHEUS_RELEASE_LABEL=prometheus

# Optional Prometheus URL used to verify target discovery.
KUBE_PROMETHEUS_URL=

# Optional Kubernetes nodeSelector as a JSON object.
KUBE_NODE_SELECTOR_JSON={}

# Optional additional Kubernetes resource limits as JSON, e.g. GPU resources.
KUBE_EXTRA_RESOURCE_LIMITS_JSON={}

# Optional Kubernetes RuntimeClass name.
KUBE_RUNTIME_CLASS=


# ==================================================
# DOCKER COMPOSE BACKEND
# ==================================================

# Optional Docker Compose project name. Defaults to mlops-<model-name>.
COMPOSE_PROJECT_NAME=

# REQUIRED: Must match the Docker host architecture.
# Common Docker platform examples: linux/amd64 | linux/arm64 | linux/arm/v7 | linux/arm/v6 | linux/386
COMPOSE_DOCKER_PLATFORM=linux/amd64

# Host port used to expose the model-serving API.
COMPOSE_MODEL_PORT=8000

# Bundled monitoring is disabled by default. Set true only when you want the bundled service.
COMPOSE_ENABLE_PROMETHEUS=false

# Host port for bundled Prometheus when enabled.
COMPOSE_PROMETHEUS_PORT=9090

# Bundled monitoring is disabled by default. Set true only when you want the bundled service.
COMPOSE_ENABLE_GRAFANA=false

# Host port for bundled Grafana when enabled.
COMPOSE_GRAFANA_PORT=3000

# Required only when Grafana is enabled while bundled Prometheus is disabled.
COMPOSE_EXTERNAL_PROMETHEUS_URL=
